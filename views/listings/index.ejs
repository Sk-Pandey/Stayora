<% layout("/layouts/boilerplate") %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
  <div class="mb-6 flex items-baseline justify-between">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Featured Listings</h1>
    <span class="text-sm text-slate-500 font-medium"><%= allListings.length %> places found</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <% allListings.forEach(element => { %>
      <article class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
        
        <div class="relative w-full aspect-[4/3] bg-slate-100">
          <img
            src="<%= element.image %>"
            alt="<%= element.title %>"
            class="w-full h-full object-cover"
            onerror="this.src='https://placehold.co/600x400?text=No+Image'"
          />
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <div class="text-xs font-medium text-emerald-600 mb-1">
              <%= element.location %>, <%= element.country %>
            </div>
            <h2 class="text-base font-semibold text-slate-900 line-clamp-1">
              <%= element.title %>
            </h2>
            <p class="text-sm font-bold text-slate-900 mt-2">
              $<%= Number(element.price).toLocaleString() %> <span class="text-xs font-normal text-slate-500">/ night</span>
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100">
            <a href="/listings/<%= element._id %>" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700">
              View Details &rarr;
            </a>
          </div>
        </div>

      </article>
    <% }) %>
  </div>
</div>