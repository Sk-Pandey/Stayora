<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Explore Listings</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen">

    <!-- Header Section -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex items-center justify-between gap-4">
        <div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900">
            Featured Listings
          </h1>
          <span class="text-xs sm:text-sm text-slate-500 font-medium">
            <%= allListings.length %> places found
          </span>
        </div>

        <!-- Add New Listing Button -->
        <a
          href="/listings/new"
          class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-all duration-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span>Add New</span>
        </a>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <!-- Responsive Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8">
        <% allListings.forEach(element => { %>
          <article class="group bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            
            <!-- Image Wrapper -->
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-slate-100">
              <img
                src="<%= element.image %>"
                alt="<%= element.title %>"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                onerror="this.src='https://placehold.co/600x400?text=No+Image+Available'"
              />
              <!-- Optional Price Tag Overlay -->
              <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full shadow-sm">
                <p class="text-xs font-semibold text-slate-900">
                  $<%= Number(element.price).toLocaleString() %> <span class="text-slate-500 font-normal">/ night</span>
                </p>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <!-- Location details -->
                <div class="flex items-center text-xs font-medium text-emerald-600 mb-1.5">
                  <svg class="w-3.5 h-3.5 mr-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                  </svg>
                  <span class="truncate"><%= element.location %>, <%= element.country %></span>
                </div>

                <!-- Title -->
                <h2 class="text-base font-semibold text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-1">
                  <%= element.title %>
                </h2>
              </div>

              <!-- Action / Button -->
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-400">Verified listing</span>
                <a
                  href="/listings/<%= element._id %>"
                  class="text-xs font-semibold text-slate-900 group-hover:text-emerald-600 flex items-center gap-1 transition-colors"
                >
                  View Details
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>

          </article>
        <% }) %>
      </div>
    </main>

  </body>
</html>