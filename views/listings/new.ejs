<% layout("/layouts/boilerplate") %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  <div class="mb-8">
    <h1
      class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
    >
      Create a New Listing
    </h1>
    <p class="text-sm text-slate-500 mt-1.5">
      Fill in the details below to publish your property.
    </p>
  </div>

  <div
    class="bg-white rounded-2xl border border-slate-200/80 shadow-md p-6 sm:p-8"
  >
    <form action="/listings" method="POST" class="space-y-6">
      <div>
        <label
          for="title"
          class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
        >
          Listing Title <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="listing[title]"
          required
          placeholder="e.g. Cozy Sunset Apartment"
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div>
        <label
          for="description"
          class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
        >
          Description <span class="text-rose-500">*</span>
        </label>
        <textarea
          id="description"
          name="listing[description]"
          rows="4"
          required
          placeholder="Describe your property..."
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        ></textarea>
      </div>

      <div>
        <label
          for="image"
          class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
        >
          Image URL <span class="text-rose-500">*</span>
        </label>
        <input
          type="url"
          id="image"
          name="listing[image]"
          required
          placeholder="https://images.unsplash.com/..."
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label
            for="price"
            class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
          >
            Price ($ / night) <span class="text-rose-500">*</span>
          </label>
          <input
            type="number"
            id="price"
            name="listing[price]"
            min="0"
            required
            placeholder="120"
            class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>

        <div>
          <label
            for="location"
            class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
          >
            Location / City <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="location"
            name="listing[location]"
            required
            placeholder="e.g. Mumbai"
            class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>
      </div>

      <div>
        <label
          for="country"
          class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
        >
          Country <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="country"
          name="listing[country]"
          required
          placeholder="e.g. India"
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div
        class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100"
      >
        <a
          href="/listings"
          class="px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 rounded-xl"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-md cursor-pointer"
        >
          Publish Listing
        </button>
      </div>
    </form>
  </div>
</div>
