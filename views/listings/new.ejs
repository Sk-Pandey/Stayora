<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Listing</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Plus Jakarta Sans", sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    <!-- Top Navigation -->
    <header
      class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs"
    >
      <div
        class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
      >
        <a
          href="/listings"
          class="inline-flex items-center text-sm font-semibold text-slate-600 hover:text-emerald-600 transition-colors"
        >
          <svg
            class="w-4 h-4 mr-1.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
            />
          </svg>
          Back to listings
        </a>
      </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <!-- Header -->
      <div class="mb-8">
        <h1
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
        >
          Create a New Listing
        </h1>
        <p class="text-sm text-slate-500 mt-1.5">
          Fill in the details below to publish your property.
        </p>
      </div>

      <!-- Listing Form Card -->
      <div
        class="bg-white rounded-2xl border border-slate-200/80 shadow-md shadow-slate-200/50 p-6 sm:p-8"
      >
        <form action="/listings" method="POST" class="space-y-6">
          <!-- Title -->
          <div>
            <label
              for="title"
              class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
            >
              Listing Title <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="listing[title]"
              required
              placeholder="e.g. Cozy Beachfront Villa"
              class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all placeholder:text-slate-400"
            />
          </div>

          <!-- Description -->
          <div>
            <label
              for="description"
              class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
            >
              Description <span class="text-rose-500">*</span>
            </label>
            <textarea
              id="description"
              name="listing[description]"
              rows="4"
              required
              placeholder="Describe your place, highlights, amenities, and vibe..."
              class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all placeholder:text-slate-400"
            ></textarea>
          </div>

          <!-- Image URL -->
          <div>
            <label
              for="image"
              class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
            >
              Image URL <span class="text-rose-500">*</span>
            </label>
            <input
              type="url"
              id="image"
              name="listing[image]"
              required
              placeholder="https://images.unsplash.com/photo-..."
              class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all placeholder:text-slate-400"
            />
          </div>

          <!-- Price & Location (2 Columns on tablet/desktop) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Price -->
            <div>
              <label
                for="price"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
              >
                Price ($ / night) <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <span
                  class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 text-sm font-semibold"
                >
                  $
                </span>
                <input
                  type="number"
                  id="price"
                  name="listing[price]"
                  min="0"
                  step="1"
                  required
                  placeholder="120"
                  class="w-full pl-8 pr-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all placeholder:text-slate-400"
                />
              </div>
            </div>

            <!-- Location / City -->
            <div>
              <label
                for="location"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
              >
                Location / City <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="location"
                name="listing[location]"
                required
                placeholder="e.g. Miami, Florida"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all placeholder:text-slate-400"
              />
            </div>
          </div>

          <!-- Country -->
          <div>
            <label
              for="country"
              class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2"
            >
              Country <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="country"
              name="listing[country]"
              required
              placeholder="e.g. United States"
              class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all placeholder:text-slate-400"
            />
          </div>

          <!-- Form Actions -->
          <div
            class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100"
          >
            <a
              href="/listings"
              class="px-5 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-colors"
            >
              Cancel
            </a>
            <button
              type="submit"
              class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-md transition-all duration-200"
            >
              <span>Publish Listing</span>
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>
