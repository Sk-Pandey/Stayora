<% layout("/layouts/boilerplate") %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <a
      href="/listings"
      class="inline-flex items-center text-sm font-semibold text-slate-600 hover:text-emerald-600 transition-colors"
    >
      &larr; Back to all listings
    </a>

    <div class="flex items-center gap-2">
      <form
        action="/listings/<%= listingDetail._id %>/edit"
        method="GET"
        class="inline"
      >
        <button
          type="submit"
          class="px-3 py-1.5 text-xs sm:text-sm font-semibold text-slate-700 bg-white hover:bg-slate-100 rounded-lg border border-slate-200 cursor-pointer"
        >
          Edit
        </button>
      </form>

      <form
        action="/listings/<%= listingDetail._id %>?_method=DELETE"
        method="POST"
        class="inline"
        onsubmit="
          return confirm('Are you sure you want to delete this listing?');
        "
      >
        <button
          type="submit"
          class="px-3 py-1.5 text-xs sm:text-sm font-semibold text-rose-600 bg-white hover:bg-rose-50 rounded-lg border border-rose-200 cursor-pointer"
        >
          Delete
        </button>
      </form>
    </div>
  </div>

  <div class="mb-6">
    <div class="text-sm font-semibold text-emerald-600 mb-2">
      <%= listingDetail.location %>, <%= listingDetail.country %>
    </div>
    <h1
      class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
    >
      <%= listingDetail.title %>
    </h1>
  </div>

  <div
    class="relative w-full aspect-[16/9] max-h-[500px] overflow-hidden rounded-2xl shadow-md bg-slate-100 mb-8"
  >
    <img
      src="<%= listingDetail.image %>"
      alt="<%= listingDetail.title %>"
      class="w-full h-full object-cover"
      onerror="this.src = 'https://placehold.co/1200x600?text=No+Image'"
    />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    <div class="lg:col-span-2 space-y-6">
      <div class="pb-4 border-b border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-2">About this place</h2>
        <p class="text-slate-600 leading-relaxed whitespace-pre-line">
          <%= listingDetail.description %>
        </p>
      </div>
    </div>

    <div class="lg:sticky lg:top-24">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-md">
        <div class="mb-4">
          <span class="text-3xl font-extrabold text-slate-900">
            $<%= Number(listingDetail.price).toLocaleString() %>
          </span>
          <span class="text-sm text-slate-500"> / night</span>
        </div>

        <button
          type="button"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-4 rounded-xl shadow-md cursor-pointer"
        >
          Reserve Now
        </button>
      </div>
    </div>
  </div>
</div>
